# Python / local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.model-cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Databases, logs and generated runtime state
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
*.err
*.out

# Model/training artifacts
*.joblib
*.npz
*.onnx
*.safetensors
*.bin

# Third-party benchmark repositories and datasets are not redistributed.
benchmarks/data/
benchmarks/data_exam/
benchmarks/vendor/
benchmarks/vendor_exam/
benchmarks/**/*.tar
benchmarks/**/*.zip
benchmarks/**/*.parquet
benchmarks/**/*.arrow

