# Python / local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.model-cache/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Databases, logs and generated runtime state
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
*.err
*.out

# Model/training artifacts
*.joblib
*.npz
*.onnx
*.safetensors
*.bin

# Third-party benchmark repositories and datasets are not redistributed.
benchmarks/data/
benchmarks/data_exam/
benchmarks/vendor/
benchmarks/vendor_exam/
benchmarks/**/*.tar
benchmarks/**/*.zip
benchmarks/**/*.parquet
benchmarks/**/*.arrow

# Publish only audited final reports/results, never checkpoints or sweeps.
benchmarks/results/*
!benchmarks/results/UMD3282_FROZEN_EXAM_REPORT.md
!benchmarks/results/UMD3282_CONTINUED_EXAM_REPORT.md
!benchmarks/results/UMD3282_CONTINUED_OPTIMIZATION_REPORT.md
